# Copy to .env and fill in your local database password.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=rag_database
DB_USER=rag_app
DB_PASSWORD=replace_with_local_database_password

GCS_BUCKET_NAME=gcp-rag-system-documents
GCS_SIGNING_SERVICE_ACCOUNT=rag-api-sa@gcp-rag-system.iam.gserviceaccount.com
UPLOAD_URL_EXPIRES_MINUTES=10
MAX_DOCUMENT_SIZE_BYTES=26214400

GOOGLE_CLOUD_PROJECT=gcp-rag-system
GOOGLE_CLOUD_LOCATION=asia-south1
EMBEDDING_MODEL=text-embedding-005
EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# Enable only after creating the queue, worker URL and OIDC invoker identity.
CLOUD_TASKS_ENABLED=false
CLOUD_TASKS_QUEUE=document-ingestion
CLOUD_TASKS_LOCATION=asia-south1
INGESTION_WORKER_URL=
TASK_INVOKER_SERVICE_ACCOUNT=
TASK_OIDC_AUDIENCE=
