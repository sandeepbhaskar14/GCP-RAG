# Copy to .env and fill in your local database password.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=rag_database
DB_USER=rag_app
DB_PASSWORD=replace_with_local_database_password

GCS_BUCKET_NAME=gcp-rag-system-documents
GCS_SIGNING_SERVICE_ACCOUNT=rag-api-sa@gcp-rag-system.iam.gserviceaccount.com
UPLOAD_URL_EXPIRES_MINUTES=10
MAX_DOCUMENT_SIZE_BYTES=26214400
